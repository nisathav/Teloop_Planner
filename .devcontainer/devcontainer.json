{
  "name": "Fleet Planner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Fleet Planner", "onAutoForward": "openBrowser" }
  },
  "waitFor": "postCreateCommand",
  "postCreateCommand": "npm install && npm run setup:demo && npm run build",
  "postAttachCommand": "npm run start:codespace",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["Prisma.prisma", "bradlc.vscode-tailwindcss"] }
  }
}
