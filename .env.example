# SQLite file (relative to prisma/). For Postgres: set provider="postgresql" in prisma/schema.prisma
# and use e.g. DATABASE_URL="postgresql://user:pass@host:5432/fleet"
DATABASE_URL="file:./dev.db"

# Admin login password. CHANGE THIS before exposing the app.
ADMIN_PASSWORD="admin"

# Secret used to sign session cookies. Any long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional read-only share link token. Leave empty to disable share mode.
# Share link: http://localhost:3000/share?token=<SHARE_TOKEN>
SHARE_TOKEN=""
